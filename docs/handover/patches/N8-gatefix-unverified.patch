     w.assignees.push(best.rid); w.orderSentAt[best.rid] = sim.t;
@@ -766,6 +779,49 @@ function lightDuty(a: FieldAgent, b: FieldAgent): boolean {
 }
 /** 구출을 넘겨받게 하는 적합도 차이 (맨손 0.1 안팎, 할리건 0.2~0.45, 유압 구조기 0.6~1.2 — 맨손은 손에 익은 할리건이나 유압 구조기가, 할리건은 유압 구조기가 넘겨받는다) */
 const RELIEF_GAP = 0.3;
+/**
+ * (N8 관문 고치기 — crews ⑤) 일하던 대원이 구출을 넘겨받으러 갈 수 있는 그 일의 종류: 장비 없이 누구나 할 수 있는 일(이송·처치·동행·수색·짝 동행 — 'standby' 는 지시를 받아 둔 대기).
+ * 구급이 모자란 교대에 유압 구조대원이 이런 일에 묶여 있는 동안 맨손의 대원이 구출을 오래 쥐었다(강제 붕괴·교통 48교대 — 그 밖이 쥔 틱의 유압 대원: 짝 동행 2527 · 수색 1431 · 처치 1080 · 이송 1015 …).
+ * 교통 통제·누출 조치는 넣지 않는다(놓는 동안 차로·밸브가 비고, 손을 뗀 사람이 그 일을 할 수 있다는 보장이 없다).
+ * brain 의 '넘겨받기 지시'(handoverOrder)도 이 표를 본다 — 그 일을 계속하는 점수보다 넘겨받기 지시를 앞세운다
+ */
+export const RELIEF_FROM: ReadonlySet<string> = new Set<string>(['carry', 'treat', 'escort', 'search', 'pair', 'standby']);
+/** 일하던 대원을 넘겨받기에 부르는 거리 (지휘관이 아는 구출 대상의 자리에서, 칸) — 구출 곁에 와 있는 사람만 (멀리서 하던 일을 끊어 불러오지 않는다) */
+const RELIEF_NEAR = 8;
+/** 같은 구출을 같은 대원에게 다시 넘겨받게 하지 않는 시간(초) — 그 작업의 마지막 지시(orderSentAt)부터. 넘겨받기 ↔ 원래 일의 왕복을 막는다 */
+const RELIEF_AGAIN = 30;
+/** 하던 일보다 이만큼 이상 급한 일(위중한 사람의 이송 등)을 하는 대원은 부르지 않는다 (구출의 우선도 기준) */
+const RELIEF_PRI = 0.1;
+/**
+ * 일하던 대원 b 를 구출 w 의 넘겨받기에 부를 수 있는가 (손이 빈 사람이 없을 때만 묻는다). 믿음·작업판·동료의 겉·조직 정보만 읽는다:
+ * 구출 곁(RELIEF_NEAR)에 있고, 지금 일과 받아 둔 지시가 모두 RELIEF_FROM 의 일(또는 spareHand 인 다른 구출)이며 구출보다 RELIEF_PRI 넘게 급하지 않고,
+ * 교본 임무로 붙잡힌 짝 동행(짝이 위험 실내에 있다 — assign 과 같은 건너뛰기)이 아니고, 이 구출의 지시를 RELIEF_AGAIN 안에 받지 않았다
+ */
+function reliefFrom(sim: Sim, s: Scene, a: FieldAgent, b: FieldAgent, w: WorkItem, tx: number, ty: number): boolean {
+  if (dist(b.x, b.y, tx, ty) > RELIEF_NEAR) return false;
+  const t = b.task;
+  if (t !== null) {
+    if (t.kind === 'extricate') { if (!spareHand(sim, s, b, t.workId)) return false; }      // 다른 구출의 둘째 손: 그 구출에 b 만큼 장비를 갖춘 사람이 남는다
+    else if (!RELIEF_FROM.has(t.kind)) return false;
+    if (docHolds(s, b) && !pairTakes(sim, s, a, b, w)) return false;
+    if (t.workId >= 0) { const cw = s.board[t.workId]; if (cw !== undefined && cw.priority >= w.priority + RELIEF_PRI) return false; }
+  }
+  if (b.orderWork >= 0 && (t === null || b.orderWork !== t.workId)) {
+    const ow = s.board[b.orderWork];
+    if (ow !== undefined && (ow.status === 'open' || ow.status === 'active') && (!RELIEF_FROM.has(ow.kind) || ow.priority >= w.priority + RELIEF_PRI)) return false;
+  }
+  const sent = w.orderSentAt[b.rid];
+  return sent === undefined || sim.t - sent >= RELIEF_AGAIN;
+}
+
+/** 구출 cw 에 b 말고도 붙어 일하는 사람이 있고, 그 사람을 b 가 넘겨받을 만큼 서툴지 않다(적합도 차이 < RELIEF_GAP) — b 가 빠져도 그 구출은 같은 장비로 이어진다 */
+function spareHand(sim: Sim, s: Scene, b: FieldAgent, cwId: number): boolean {
+  const cw = s.board[cwId];
+  if (cw === undefined || cw.kind !== 'extricate' || cw.status !== 'active') return false;
+  const mine = fitFor(sim, s, b, cw);
+  for (const q of s.agents) if (q !== b && q.status === 'active' && q.task !== null && q.task.workId === cwId && fitFor(sim, s, q, cw) + RELIEF_GAP > mine) return true;
+  return false;
+}
 
 function targetX(s: Scene, w: WorkItem, a: FieldAgent): number {
   if (w.region >= 0) return s.regions[w.region].cx;
