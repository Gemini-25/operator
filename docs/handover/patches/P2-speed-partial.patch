@@ -80,8 +85,13 @@ export function widenShapes(sim: Sim): void {
   widen(want(fake, s, 'search', {}, 0), WORK);
   widen(addRegion(s, '', 'room', 1, 1, 2, 2, true, true), REGION);
   widen(addProp(s, 'valve', 1, 1), PROP);
-  widen(addCas(s, 1, 1, 'immobile', 50, 0, 0), CAS);
-  widen(addHostile(s, 1, 1, 'gun', 0.5, 0.5, false, 0.3), HOSTILE);
+  const c = widen(addCas(s, 1, 1, 'immobile', 50, 0, 0), CAS);
+  const h = widen(addHostile(s, 1, 1, 'gun', 0.5, 0.5, false, 0.3), HOSTILE);
+  widen(casFact(fake, s, c, '').value as object, CAS_V);
