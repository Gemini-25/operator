@@ -728,6 +728,19 @@ export function assign(sim: Sim, s: Scene, I: Incident, a: FieldAgent): void {
       const fit = fitFor(sim, s, b, w);
       if (fit >= bf) { bf = fit; best = b; }
     }
+    // (N8 관문 고치기 — crews ⑤) 손이 빈 사람이 없으면: 장비 없이 누구나 할 수 있는 일(RELIEF_FROM — 이송·처치·동행·수색·짝 동행)이나 같은 장비의 사람이 남는 다른 구출의 둘째 손(spareHand)을 하며
+    // 그 구출 곁(RELIEF_NEAR)에 와 있는 사람 (reliefFrom). 그가 놓은 일은 작업판에 다시 열려 손을 뗀 사람(또는 다른 대원)이 받는다 — 둘이 일을 바꿔 든다.
