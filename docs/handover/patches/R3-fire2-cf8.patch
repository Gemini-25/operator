diff --git a/src/sim/field/commander.ts b/src/sim/field/commander.ts
index e52c122..5179ead 100644
--- a/src/sim/field/commander.ts
+++ b/src/sim/field/commander.ts
@@ -704,6 +704,7 @@ export function assign(sim: Sim, s: Scene, I: Incident, a: FieldAgent): void {
       if (swatOn && bestNoCs !== null && bestNoCs !== best) recordDoc(sim, I, null, 'CS2', 'cmd', { work: w.kind, tgt: 'w:' + w.id }, ordEv);      // (CS2) 가산이 고른 사람을 바꾸었다
     }
   }
+  if (DOC_SWITCH.SPARE) sparePair(sim, s, I, a, items, taken);      // (균형 보탬 CF8) 남는 대원에게 짝을 지어 다른 방을 맡긴다
   // 교대: 구출을 맡은 사람이 다 찼는데(먼저 닿은 대원이 맨손으로 붙들고 있다), 손이 빈 대원 가운데 훨씬 나은 장비를 든 사람이 있으면
   // (뒤에 닿은 구조대의 유압 구조기) 그 사람을 보낸다. 닿으면 그 자리에서 가장 서툰 사람과 자리를 바꾼다(executor 의 구출 임무 — relieve).
   // 한 작업의 사람 수(max)는 그대로다: 넘겨받는 동안만 한 명이 더 붙는다. 적합도는 든 장비로만 본다(fitFor — 숨은 고장은 모른다)
@@ -1016,3 +1017,134 @@ function pairTakes(sim: Sim, s: Scene, a: FieldAgent, b: FieldAgent, w: WorkItem
   return mw !== undefined && nearWork(s, a, mw, w);
 }
 import { nearWork } from './doctrine';
+
+// ───────────────────────── (균형 보탬 — 사용자 결정 2026-11-16 둘째) 남는 대원의 짝 투입 (지휘 CF8) ─────────────────────────
+import type { CrewBelief } from '../types';
+import { SOLO_OK } from './doctrine';
+import { roleIdOf } from './gear';
+import { tileOf } from './grid';
+import { pairBy } from './doctrineRun';
+/**
+ * 남는 대원 — 지휘관이 새 짝으로 붙일 수 있는 손 빈 공기호흡기 대원 (조직 정보·동료의 겉·지휘관 믿음 속 자기 신고만 읽는다):
+ * 지휘관이 아니고 혼자 서는 역할(기관원·사다리 조작원 … — 밖 대기조로 선다)이 아니며, 활동·땅 위·업지 않음·부대에 철수 지시 없음·걸을 수 있는 다친 대원 아님,
+ * 공기호흡기를 멨고 공기 50% 이상(R1 airShort — 조직 정보), 임무 없음(대기)·받은 지시 없음, 지휘관이 아는 자기 신고가 중상이 아니다
+ */
+function spareOk(sim: Sim, s: Scene, a: FieldAgent, b: FieldAgent, taken: Set<number>): boolean {
+  if (b === a || b.status !== 'active' || b.aloft || b.carrying !== -1 || taken.has(b.rid) || sim.units[b.unitId].boardOrder) return false;
+  if ((b.task !== null && b.task.kind !== 'standby') || b.orderWork >= 0) return false;
+  if (sim.responders[b.rid].status === 'injured' || !hasKit(sim, b.rid, 'scba') || airShort(sim, b.rid)) return false;
+  const ro = roleIdOf(sim, b.rid);
+  if (ro !== null && SOLO_OK.has(ro)) return false;
+  const v = a.beliefs.val<CrewBelief>('crew', b.rid);
+  return (v === undefined || v.band < 1) && !assignedAny(s, b);
+}
+/** 그 대원의 역할이 앞세우는 일(역할 선호 ≥ 0.2 — 유압 구조대원의 구출 …)이 자리가 남은 채 열려 있고 맡을 수 있다 — 짝으로 데려가지 않는다 (pairAssign 과 같은 조건 — tests/crews.test.ts ⑤) */
+function specialtyOpen(sim: Sim, s: Scene, b: FieldAgent, items: WorkItem[]): boolean {
+  const pref = roleOf(sim, b.rid).prefer;
+  for (let k = 0; k < items.length; k++) { const w = items[k]; if ((pref[w.kind] ?? 0) >= 0.2 && w.assignees.length < w.max && fitFor(sim, s, b, w) > 0) return true; }
+  return false;
+}
+/** 작업판의 열린 일에 담당자로 올라 있다 (지시가 아직 닿지 않았어도 — 무전은 1.2초 뒤에 닿는다. 그 사이의 사람을 손 빈 사람으로 보지 않는다) */
+function assignedAny(s: Scene, b: FieldAgent): boolean {
+  for (let k = 0; k < s.board.length; k++) { const w = s.board[k]; if ((w.status === 'open' || w.status === 'active') && w.assignees.indexOf(b.rid) >= 0) return true; }
+  return false;
+}
+/** 적합도를 0 으로 만든 교본 줄이 짝 없음(F04) 하나뿐이다 — 짝만 생기면 맡을 수 있다 */
+function noBuddyOnly(fp: DocFitAns): boolean {
+  let f04 = false;
+  for (let k = 0; k < fp.hits.length; k++) { const h = fp.hits[k]; if (h.mul !== 0) continue; if (h.rule.id !== 'F04') return false; f04 = true; }
+  return f04;
+}
+/**
+ * 남는 대원 가운데 그 대원의 짝으로 붙일 사람: 관창이 없는 사람을 먼저(관창을 든 사람은 다음 방의 진압을 앞장설 수 있게 남긴다 — 거리 6칸 몫), 그다음 가까운 사람
+ * (같으면 rid 가 작은 쪽, not 은 뺀다)
+ */
+function nearestSpare(sim: Sim, spares: FieldAgent[], p: FieldAgent, not: FieldAgent | null): FieldAgent | null {
+  let best: FieldAgent | null = null, bd = Infinity;
+  for (let k = 0; k < spares.length; k++) {
+    const q = spares[k];
+    if (q === p || q === not) continue;
+    const d = dist(p.x, p.y, q.x, q.y) + (hasKit(sim, q.rid, 'hose') ? SPARE_HOSE_COST : 0);
+    if (d < bd || (d === bd && best !== null && q.rid < best.rid)) { bd = d; best = q; }
+  }
+  return best;
+}
+/** 관창을 든 남는 대원을 짝으로 붙이는 데 더하는 거리 (칸) */
+const SPARE_HOSE_COST = 6;
+/** 맡을 사람 후보의 점수에 더하는 몫: 지금 짝이 위험 실내 일에 묶이지 않은 사람(짝을 바꿔도 아무도 안에 혼자 남지 않는다) — 짝을 둘 바꾸는 갈래보다 남는 대원끼리 짝을 짓는 갈래를 먼저 */
+const SPARE_KEEP = 0.3;
+/** 그 대원의 짝 (같은 현장의 활동 중인 사람, 없으면 null) */
+function buddyAgent(s: Scene, b: FieldAgent): FieldAgent | null {
+  const id = b.buddy;
+  if (id === undefined || id < 0) return null;
+  for (let k = 0; k < s.agents.length; k++) { const m = s.agents[k]; if (m.rid === id && m !== b && m.status === 'active') return m; }
+  return null;
+}
+/** 그 대원(없으면 거짓)이 위험 실내 일에 묶였다 — inJobBound */
+function bound(sim: Sim, s: Scene, a: FieldAgent, b: FieldAgent | null): boolean { return b !== null && inJobBound(sim, s, a, b); }
+/** 그 대원이 위험 실내 일에 묶였다 (지금 임무·받은 지시·작업판의 담당자 — 공개 지휘 상태): 그 짝을 떼어 가면 안에서 혼자가 된다 */
+function inJobBound(sim: Sim, s: Scene, a: FieldAgent, b: FieldAgent): boolean {
+  if (b.task !== null && b.task.workId >= 0) { const w = s.board[b.task.workId]; if (w !== undefined && (w.status === 'open' || w.status === 'active') && inJob(sim, s, a, w, b.task)) return true; }
+  if (b.orderWork >= 0) { const w = s.board[b.orderWork]; if (w !== undefined && (w.status === 'open' || w.status === 'active') && inJob(sim, s, a, w)) return true; }
+  for (let k = 0; k < s.board.length; k++) { const w = s.board[k]; if ((w.status === 'open' || w.status === 'active') && w.assignees.indexOf(b.rid) >= 0 && inJob(sim, s, a, w)) return true; }
+  return false;
+}
+/**
+ * (균형 보탬 — 사용자 결정 2026-11-16 둘째 — 남는 대원도 짝을 지어 다른 방으로) 두 번의 배정이 끝난 뒤에도 담당자가 없는 새 방의 위험 실내 일(수색·진압·잔불 정리 — PAIR_SLOT)이 남았으면,
+ * 그 일을 맡을 수 있는데 짝이 따라올 수 없어서만(교본 F04 — 짝이 다른 방에서 일하거나·혼자 서는 역할이거나·없다) 못 맡는 공기호흡기 대원 X 에게 남는 대원 Y(spareOk — 다른 부대여도)를
+ * 새 짝으로 붙이고 그 일을 준다 (지시 끝 "— Y 와 짝으로"). Y 는 다음 판단에 짝 동행(G08)으로 X 를 따라 들어간다. 2인 진입(F04·F04c)·밖 대기조(F05)는 그대로 — 짝이 생겨서 맡는 것이다.
+ * X 의 지금 짝 L 이 위험 실내 일에 묶였으면(X 가 짝 동행으로 따라가던 앞장선 짝 — SPARE_SPLIT, 또는 방금 일을 받은 짝) 남는 대원이 둘 있어야 한다: 하나는 X 의 새 짝, 하나는 L 의 새 짝
+ * (L 이 안에 혼자 남지 않게 — 그 대원도 G08 로 따라간다). 짝으로 붙일 남는 대원은 관창이 없는 사람을 먼저 고른다(관창을 든 사람은 다음 방의 진압을 앞장선다).
+ * 진단(fire2 — 강제 fire/std): D8 로 사람은 늘었지만 손 빈 공기호흡기 대원이 불이 남은 표본당 3.8명 밖에 서 있었다 — 일이 없던 때가 대부분이고, 일이 있을 때는 그 일이 진압(관창이 없는 사람은 못 한다)이거나
+ * 맡을 사람의 짝이 다른 방에 있었다(F04). 관창을 든 두 사람(관창수·진입대원)이 한 짝이라 한 방에 둘이 들어가고, 관창 없는 팀장·구조대원은 밖에 남았다.
+ * 믿음·작업판·동료의 겉·조직 정보만 읽는다. 지휘관이 음영 구역이면(지시가 나가지 않는다) 하지 않는다
+ */
+function sparePair(sim: Sim, s: Scene, I: Incident, a: FieldAgent, items: WorkItem[], taken: Set<number>): void {
+  let open = false;
+  for (let k = 0; k < items.length; k++) { const w = items[k]; if (w.assignees.length === 0 && PAIR_SLOT.has(w.kind) && sim.t >= w.holdUntil) { open = true; break; } }
+  if (!open || s.shadow[tileOf(s, a.x, a.y)]) return;
+  let spares: FieldAgent[] | null = null;
+  for (let k = 0; k < items.length; k++) {
+    const w = items[k];
+    if (w.assignees.length !== 0 || !PAIR_SLOT.has(w.kind) || sim.t < w.holdUntil || !inJob(sim, s, a, w)) continue;
+    if (spares === null) { spares = []; for (let j = 0; j < s.agents.length; j++) { const b = s.agents[j]; if (spareOk(sim, s, a, b, taken) && !bound(sim, s, a, buddyAgent(s, b)) && !specialtyOpen(sim, s, b, items)) spares.push(b); } }      // 짝이 위험 실내 일에 묶인 사람은 그 짝의 동행이 될 사람이다 — 남는 대원이 아니다
+    if (!spares.length) return;
+    // 맡을 사람 후보: 짝이 따라올 수 없어서만 못 맡는 손 빈 대원, 짝 동행 중인 대원 — 점수는 배정과 같은 모양, 지금 짝을 떼어 놓지 않아도 되는 사람 +SPARE_KEEP
+    let best: FieldAgent | null = null, bs = -Infinity, bestL: FieldAgent | null = null;
+    for (let j = 0; j < s.agents.length; j++) {
+      const x = s.agents[j];
+      if (x === a || x.status !== 'active' || x.aloft || x.carrying !== -1 || taken.has(x.rid) || sim.units[x.unitId].boardOrder || sim.responders[x.rid].status === 'injured') continue;
+      const follow = x.task !== null && x.task.kind === 'pair';
+      if (follow ? !DOC_SWITCH.SPARE_SPLIT : !((x.task === null || x.task.kind === 'standby') && x.orderWork < 0)) continue;
+      if (failedRecently(sim, w, x.rid) || assignedAny(s, x)) continue;
+      // 지금 짝 L 이 위험 실내 일에 묶였으면(짝 동행으로 따라가던 앞장선 짝, 또는 방금 일을 받은 짝) L 에게 남는 대원 하나를 대신 붙인다 — 남는 대원이 둘 있어야 한다
+      let l = buddyAgent(s, x);
+      if (!bound(sim, s, a, l)) l = null;
+      if (follow && l === null) continue;      // 짝 동행인데 앞장선 짝이 위험 실내 일을 하지 않는다 — 곧 동행이 끝난다(그때 손 빈 대원으로 본다)
+      if (l !== null && spares.length < 2) continue;
+      const fp = fitParts(sim, s, x, w);
+      if (fp.base <= 0 || fp.fit > 0 || !noBuddyOnly(fp)) continue;
+      const r = sim.responders[x.rid];
+      const d = dist(x.x, x.y, targetX(s, w, a), targetY(s, w, a));
+      const sc = fp.base * 0.5 + (1 - Math.min(1, d / 34)) * 0.22 + (r.stamina / 100) * 0.1 + r.experience * 0.08 + (l === null ? SPARE_KEEP : 0);      // 지금 짝을 떼어 놓지 않아도 되는 사람을 먼저 (남는 대원끼리 짝을 짓는다)
+      if (sc > bs) { bs = sc; best = x; bestL = l; }
+    }
+    if (best === null) continue;
+    const y = nearestSpare(sim, spares, best, null);
+    if (y === null) continue;
+    const y2 = bestL !== null ? nearestSpare(sim, spares, bestL, y) : null;
+    if (bestL !== null && y2 === null) continue;
+    // 짝을 다시 맺는다 (옛 짝은 비운다 — 다음 판단에 rebuddy 가 본다): X ↔ Y, (짝 동행이었으면) L ↔ Y2
+    pairBy(s, best, y);
+    if (bestL !== null && y2 !== null) pairBy(s, bestL, y2);
+    taken.add(best.rid); taken.add(y.rid);
+    spares.splice(spares.indexOf(y), 1);
+    if (y2 !== null) { taken.add(y2.rid); spares.splice(spares.indexOf(y2), 1); }
+    w.assignees.push(best.rid); w.status = 'active'; w.orderSentAt[best.rid] = sim.t;
+    const xn = sim.responders[best.rid].name, yn = sim.responders[y.rid].name;
+    const ordEv = transmit(sim, s, a, best.rid, 'order', [], `${xn}, ${workLabel(s, w, sim)}${w.kind === 'search' || w.kind === 'suppress' ? ' 실시' : ' 맡아라'} — ${josa(yn, '과/와')} 짝으로.`, w.id, w.priority > 0.8 ? 1 : 0, w.cause >= 0 ? [w.cause] : []);
+    if (bestL !== null && y2 !== null) { const ln = sim.responders[bestL.rid].name, y2n = sim.responders[y2.rid].name; transmit(sim, s, a, y2.rid, 'order', [], `${y2n}, ${josa(ln, '과/와')} 짝으로 들어가라.`, -1, 0); }
+    if (ordEv >= 0) recordDoc(sim, I, null, 'CF8', 'cmd', { work: w.kind, tgt: 'w:' + w.id, mate: y.rid }, ordEv);
+    if (!spares.length) return;
+  }
+}
