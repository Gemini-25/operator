{
  "name": "autonomous-response",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "자율형 긴급구조 조직 시뮬레이션 — AI 관제·현장 대원을 관찰하는 2D 시뮬레이션",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sweep": "tsx scripts/sweep.ts",
    "ui-check": "node scripts/ui-check.cjs",
    "check": "tsc --noEmit && vitest run && tsx scripts/sweep.ts 40 --check"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
