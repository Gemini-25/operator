+const HANDOVER_BONUS = 0.12;
+function handoverOrder(w: WorkItem, cur: FieldAgent['task']): boolean {
+  return w.kind === 'extricate' && w.assignees.length > w.max && cur !== null && cur.workId !== w.id && cur.kind !== 'standby' && (RELIEF_FROM.has(cur.kind) || cur.kind === 'extricate');
