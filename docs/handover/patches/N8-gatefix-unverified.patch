+/**
+ * (N8 관문 고치기 — 보통 S7 #13) 부대 u 를 빼 오면 사건 J 가 아무 부대도 오지 않는 채로 남는가: 아직 아무도 닿지 않았고(지상·상공 — 무대응 종료의 조건과 같다) J 에 배정된 부대가 u 하나뿐이다.
+ * 그런 전환 배정은 J 를 다른 부대가 날 때까지 맨 처음부터 기다리게 한다 — 부대가 모자란 교대에서는 신고 접수 330초의 무대응 종료(incidents.tickIncidents)가 먼저 닫았다
+ * (타는 냄새 신고에 가던 사다리1 을 교통사고로 빼 온 뒤 진압 부대가 모두 다른 화재·붕괴에 묶여 243초 뒤에야 다음 부대가 배정됐다)
+ */
+function orphaned(sim: Sim, J: Incident, u: Unit): boolean {
+  if (J.firstArrivalAt >= 0 || (sim.scenes[J.id]?.airAt ?? -1) >= 0) return false;
+  for (const uid of J.assigned) if (uid !== u.id) return false;
+  return true;
+}
+/**
+ * 빼 오는 부대 u 대신 사건 J 에 지금 보낼 수 있는 지상 부대가 있는가: u 가 채우던 J 의 수요(평가한 수요 가운데 u 의 능력이 기준을 넘는 열쇠) 하나라도 기준을 넘고,
+ * 가용·복귀 중이며 출동할 대원이 있는 부대. 관제가 아는 것만 읽는다 — 자기 평가(J.assessment)와 자기 조직의 부대 상태·편성
+ */
+function spareFor(sim: Sim, J: Incident, u: Unit): boolean {
+  const needs = J.assessment!.needs;
+  for (const q of sim.units) {
+    if (q === u || q.air || q.sea || (q.state !== 'available' && q.state !== 'returning') || crewReady(sim, q) === 0 || J.assigned.indexOf(q.id) >= 0) continue;
+    for (const key of ORDER) {
+      if (!(needs[key] > 0) || u.caps[key] < MINCAP[key] || q.caps[key] < MINCAP[key]) continue;
+      if (KIND_AUX.has(q.kind) && kindFit(sim, q, J, key) <= 0) continue;
+      return true;
+    }
+  }
+  return false;
+}
+
 function pickUnit(sim: Sim, I: Incident, key: keyof Needs, minCap: number): { best: Cand | null; nearest: Cand | null } {
   const sev = I.assessment!.severity;
   const cands: Cand[] = [];
@@ -238,6 +265,7 @@ function pickUnit(sim: Sim, I: Incident, key: keyof Needs, minCap: number): { be
       if (J.problems.some((p) => p.code === 'DIVERTED' && sim.t - p.t < 120)) continue;
       const gap = I.priority - J.priority;
       if (gap < (J.assigned.filter((uid) => uid !== J.coResp).length > 1 ? 0.9 : 1.4)) continue;      // 선착 대응으로 함께 간 소방차는 세지 않는다 (그 사건의 하나뿐인 구급차를 쉽게 빼앗지 않게)
+      if (orphaned(sim, J, u) && !spareFor(sim, J, u)) continue;      // (N8 관문 고치기) 아무도 닿지 않은 사건의 하나뿐인 부대는 대신 보낼 부대가 지금 있을 때만 빼 온다
       divertFrom = J;
     } else if (u.state !== 'available' && u.state !== 'returning') continue;
     const eta = etaFor(sim, u, I.reportedNode);
