 import { addCas, addHostile, addProp, addRegion, baseScene } from './field/kit';
+import { newOps } from './field/ops';
 
 /**
  * 넓힌 가짜 객체를 붙잡아 둔다: 모양(map)은 그 모양의 객체가 하나도 없으면 GC 가 거두고, 리터럴의 모양 캐시도 약하게 붙잡으므로
@@ -52,6 +53,10 @@ const UNIT = ['x', 'y', 'px', 'py', 'water', 'waterMax', 'pumpCond', 'tool', 'me
 const RESPONDER = ['skill', 'judgment', 'composure', 'fitness', 'teamwork', 'experience', 'health', 'stamina', 'bleed', 'bleed0', 'treatQ', 'tDown', 'tDead'] as const;
 const INCIDENT = ['createdAt', 'followupAt', 'firstCallAt', 'reportedAt', 'answeredAt', 'unmetSince', 'firstDispatchAt', 'firstArrivalAt', 'closedAt', 'priority', 'reportedNode'] as const;
 const TRUTH = ['x', 'y', 'nodeId'] as const;
+const CAS_V = ['x', 'y', 'drift'] as const;      // 사실의 값: 구조 대상 (agents.casFact)
+const HOS_V = ['x', 'y', 'facing'] as const;      // 용의자 (agents.hosFact)
