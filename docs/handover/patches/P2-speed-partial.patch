@@ -0,0 +1,93 @@
+// (P2 속도) 자주 도는 객체의 숫자 칸을 처음부터 소수 표현으로 넓혀 둔다 — 결과와 무관하다 (값을 넣었다가 그대로 되돌린다).
+//
+// 까닭: V8 은 객체의 숫자 칸을 처음 들어온 값의 표현으로 시작한다(정수면 Smi). 나중에 그 칸에 소수(또는 소수 표현의 정수 —
+// 소수 칸에서 읽은 값은 최적화되지 않은 코드에서 정수라도 소수 표현이다)가 들어오면, 그 모양(map)을 버리고 새 모양을 만든다.
+// 버린 모양에 기대어 최적화된 함수는 모두 버려지고 다시 컴파일된다. 교대 도중 드문 길(처음 나온 사건 종류)이 처음 소수를 넣을
+// 때마다 수십~수백 함수가 그렇게 되어, 헤드리스 실행의 사용자 CPU 절반 남짓이 다시 컴파일이었다 (docs/specs/P2-speed.md).
+// 여기서 프로세스마다 한 번, 각 종류의 객체를 진짜 만드는 함수로 하나 만들어 (또는 처음 생긴 진짜 객체에) 소수를 넣었다 빼면,
+// 그 뒤 만드는 모든 객체가 처음부터 넓힌 모양을 쓴다(같은 리터럴·같은 칸 순서의 객체는 모양을 함께 쓴다).
+//
+// 지킬 것: 값을 바꾸지 않는다(같은 값을 되돌린다), 난수·Sim 상태를 건드리지 않는다, 칸을 더하지 않는다(가짜 객체는 버린다).
+// 목록은 진단으로 정했다 — 교대를 여럿 돌린 뒤 소수 표현이 된 칸 (도구: P2-speed.md). 새 숫자 칸을 만들 때 나중에 소수가 들어갈 수
+// 있으면 여기 목록에도 넣는다 (빠뜨려도 결과는 같다 — 느려질 뿐이다).
+
+import type { Sim } from './engine';
+import type { Incident } from './types';
+import { Rng } from './rng';
+import { makeAgent } from './field/agents';
+import { makeTask } from './field/executor';
+import { mkFact } from './field/beliefs';
+import { want } from './field/commander';
+import { addCas, addHostile, addProp, addRegion, baseScene } from './field/kit';
+
+/**
+ * 넓힌 가짜 객체를 붙잡아 둔다: 모양(map)은 그 모양의 객체가 하나도 없으면 GC 가 거두고, 리터럴의 모양 캐시도 약하게 붙잡으므로
+ * 다음에 그 종류가 처음 생길 때 넓히지 않은 새 모양부터 다시 시작한다 (용의자가 없는 교대 뒤의 첫 무장 사건에서 실제로 그랬다)
+ */
+const KEEP: object[] = [];
+/** 칸마다 소수를 한 번 넣고 원래 값을 되돌린다 (원래 값이 undefined 면 일반 표현이 된다 — 그것도 나중에 모양을 바꾸지 않는다) */
+function widen<T extends object>(o: T, keys: readonly string[]): T {
+  const r = o as Record<string, unknown>;
+  for (let k = 0; k < keys.length; k++) { const key = keys[k], v = r[key]; r[key] = 0.5; r[key] = v; }
+  KEEP.push(o);
+  return o;
+}
+
+const AGENT = ['x', 'y', 'px', 'py', 'fx', 'fy', 'nextThink', 'ring', 'arrivedAt', 'idleSince', 'planT', 'outboxSince', 'shadowSince', 'nextPerceive', 'cooldown',
+  'smokeT', 'rehabLogAt', 'lastRetreatLog', 'hpTick', 'climb', 'taserAt', 'underFireT', 'pendingBlock', 'equipRetryAt'] as const;
+const TASK = ['progress', 'need', 'startedAt', 'repathAt', 'tx', 'ty', 'wait', 'gateAt', 'range', 'region', 'cas', 'prop', 'hostile', 'tile', 'mate',
+  'mt0', 'cvX', 'cvY', 'cvTx', 'cvTy', 'cvLost'] as const;
+const FACT = ['t', 'conf', 'id'] as const;
+const WORK = ['priority', 'createdAt', 'doneAt', 'holdUntil', 'region', 'cas', 'prop', 'hostile', 'tile', 'mate'] as const;
+const SCENE = ['exposure', 'startedAt', 'clearVision', 'nextCarAt', 'trafficFlow', 'outdoorVision', 'arrivedAt', 'fireOutAt', 'lastSitrep', 'negotStart',
+  'closedCheckAt', 'idleSince', 'triageAt', 'allIdleSince', 'rollCallAt', 'secureAt', 'breachAt', 'bangAt', 'airAt'] as const;
+const REGION = ['cx', 'cy', 'x0', 'y0', 'x1', 'y1'] as const;
+const PROP = ['x', 'y', 'hp', 'angle', 'leakRate', 'fuse', 'heatLoad', 'heatK'] as const;
+const CAS = ['health', 'bleed', 'concealment', 'bleed0', 'x', 'y', 'px', 'py', 'trapWork', 'treatProg', 'treatQ', 'wanderT', 'drift',
+  'tDiscovered', 'tFreed', 'tTreated', 'tSafe', 'tLoaded', 'tDead', 'tHospital'] as const;
+const HOSTILE = ['x', 'y', 'px', 'py', 'health', 'morale', 'aggression', 'skill', 'fleeAt', 'facing', 'lookAt', 'deadline', 'cooldown', 'negot', 'stunUntil',
+  'alertUntil', 'shotAt', 'moveAt', 'bleed', 'bleed0', 'treatQ', 'tTreated', 'tDown', 'tDead', 'hideUntil'] as const;
+const UNIT = ['x', 'y', 'px', 'py', 'water', 'waterMax', 'pumpCond', 'tool', 'medLevel', 'armor', 'segT', 'timer', 'dispatchedAt', 'estArrive', 'busyTime',
+  'fuel', 'nodeId', 'destNode', 'curbT', 'firstLoadAt'] as const;
+const RESPONDER = ['skill', 'judgment', 'composure', 'fitness', 'teamwork', 'experience', 'health', 'stamina', 'bleed', 'bleed0', 'treatQ', 'tDown', 'tDead'] as const;
+const INCIDENT = ['createdAt', 'followupAt', 'firstCallAt', 'reportedAt', 'answeredAt', 'unmetSince', 'firstDispatchAt', 'firstArrivalAt', 'closedAt', 'priority', 'reportedNode'] as const;
+const TRUTH = ['x', 'y', 'nodeId'] as const;
+
+let fieldDone = false, rosterDone = false, incidentDone = false;
+
+/**
+ * Sim 생성자 끝에서 부른다. 프로세스마다 한 번: 현장 객체(대원·임무·사실·작업·현장·구역·소품·구조 대상·용의자)를 가짜로 하나씩 만들어 넓히고,
+ * 처음 만든 Sim 의 진짜 부대·대원을 넓힌다 (같은 값을 되돌리므로 그 교대의 결과는 같다).
+ */
+export function widenShapes(sim: Sim): void {
+  if (!rosterDone) {
+    rosterDone = true;
+    for (const u of sim.units) widen(u, UNIT);
+    for (const r of sim.responders) widen(r, RESPONDER);
+  }
+  if (fieldDone) return;
+  fieldDone = true;
+  // 가짜 교대·사건: 만드는 함수가 읽는 칸만 (시각·날씨·사건 종류)
+  const fake = { t: 0, weather: 'clear' } as unknown as Sim;
+  const I = { id: 0, truth: { type: 'fire', variant: 'std' } } as unknown as Incident;
+  widen(makeAgent(fake, 0, 0, 0, 0, 0, new Rng(1)), AGENT);
+  widen(makeTask('standby', ''), TASK);
+  widen(mkFact('cas', 0, null, '', 0, 1, true, ''), FACT);
+  const s = baseScene(fake, I, new Rng(2));
+  // sceneManager.createScene 이 만든 뒤 붙이는 칸 (같은 순서 — 같은 모양)
+  s.allIdleSince = -1; s.rollCallAt = -1e9; s.air = []; s.light = null; s.airAt = -1;
+  widen(s, SCENE);
+  widen(want(fake, s, 'search', {}, 0), WORK);
+  widen(addRegion(s, '', 'room', 1, 1, 2, 2, true, true), REGION);
+  widen(addProp(s, 'valve', 1, 1), PROP);
+  widen(addCas(s, 1, 1, 'immobile', 50, 0, 0), CAS);
+  widen(addHostile(s, 1, 1, 'gun', 0.5, 0.5, false, 0.3), HOSTILE);
+}
+
+/** sceneManager.createScene 에서 부른다: 처음 생긴 사건(진짜 객체)을 넓힌다 — 사건 리터럴은 incidents.createIncident 안에만 있다 */
+export function widenIncident(I: Incident): void {
+  if (incidentDone) return;
+  incidentDone = true;
+  widen(I, INCIDENT);
+  widen(I.truth, TRUTH);
+}
-- 
